<?xml version="1.0"?>
<ruleset name="wp-cli-eject-command">
	<description>Coding standards for wp-cli-eject-command (the WP-CLI ruleset).</description>

	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/templates/*</exclude-pattern>
	<!-- Standalone scripts the skill ships for machines without npx, wp or git: global scope on purpose. -->
	<exclude-pattern>*/skills/*</exclude-pattern>

	<arg value="p"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="8"/>

	<rule ref="WP_CLI_CS"/>

	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="Camaleaun\Eject"/>
			</property>
		</properties>
	</rule>
</ruleset>
